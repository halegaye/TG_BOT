NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tg_bot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tg_bot_db?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

PORT_API=4000
PORT_WEB=3000

TOKEN_ENCRYPTION_KEY=super_secret_encryption_key_32_bytes_min_length_enterprise_2026

# Production / Public Tunnel URL for Telegram Webhooks (e.g. ngrok, localtunnel or public domain)
# Example ngrok setup: ngrok http 4000 -> WEBHOOK_BASE_URL=https://<ngrok-id>.ngrok-free.app
WEBHOOK_BASE_URL=https://hooks.example.com
JWT_SECRET=super-secret-key-change-in-production
